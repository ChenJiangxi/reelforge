{
  "_": "镜头模板目录。规划提示词(worker/prompts.mjs)和网页上的镜头编辑器都读这份。改字段要同时改 shots/tpl 里的组件。",
  "templates": [
    {
      "id": "page",
      "label": "产品页",
      "use": "讲到产品功能、报告里的具体内容时用(最优先):真实产品页放在手机里,念到哪段就滚到哪段、推近到读得清、在那几个字下面划金线、光标点一下。focus 必须是那张产品页上真有的字(从产品页文字清单里原样抄),按念到的顺序排",
      "cues": "focus",
      "fields": [
        {
          "key": "page",
          "label": "哪张产品页",
          "type": "text",
          "max": 40
        },
        {
          "key": "focus",
          "label": "要推近划线的字(页面上的原文,按念到的顺序)",
          "type": "list",
          "min": 1,
          "max": 3,
          "itemMax": 20
        },
        {
          "key": "mode",
          "label": "样式",
          "type": "select",
          "options": [
            "phone",
            "page"
          ],
          "labels": {
            "phone": "手机里(光标敲黑板)",
            "page": "铺满画面"
          },
          "optional": true
        },
        {
          "key": "__page",
          "label": "页面数据",
          "type": "hidden",
          "optional": true
        }
      ],
      "example": {
        "page": "遇见正缘报告",
        "focus": [
          "清冷理性的伴侣",
          "2029"
        ],
        "mode": "phone"
      }
    },
    {
      "id": "scene",
      "label": "画面",
      "use": "讲情绪、场景、人物状态、比喻、命理意象的地方用它:按 prompt 生成一张画面铺满全屏,镜头缓慢运动,上面最多压一句关键词。片子不能全是字 —— 全片三到五成镜头应该是画面。画面里有主角时 who 写 main(全片同一个人)",
      "cues": "big",
      "fields": [
        {
          "key": "prompt",
          "label": "画面描述(生图用,不上屏)",
          "type": "text",
          "max": 90
        },
        {
          "key": "who",
          "label": "主角出镜",
          "type": "select",
          "options": [
            "main",
            "none"
          ],
          "optional": true,
          "labels": {
            "main": "主角在画面里",
            "none": "没有主角"
          }
        },
        {
          "key": "big",
          "label": "压在画面上的字",
          "type": "text",
          "max": 10,
          "optional": true
        },
        {
          "key": "kicker",
          "label": "小标签",
          "type": "text",
          "max": 8,
          "optional": true
        },
        {
          "key": "motion",
          "label": "镜头运动",
          "type": "select",
          "options": [
            "push",
            "pull",
            "left",
            "right",
            "up"
          ],
          "optional": true,
          "labels": {
            "push": "慢慢推近",
            "pull": "慢慢拉远",
            "left": "向左移",
            "right": "向右移",
            "up": "向上移"
          }
        },
        {
          "key": "place",
          "label": "字的位置",
          "type": "select",
          "options": [
            "top",
            "center"
          ],
          "optional": true,
          "labels": {
            "top": "上方",
            "center": "画面中间"
          }
        },
        {
          "key": "src",
          "label": "图",
          "type": "hidden",
          "optional": true
        },
        {
          "key": "srcKey",
          "label": "图的缓存键",
          "type": "hidden",
          "optional": true
        }
      ],
      "example": {
        "prompt": "她和男朋友坐在咖啡馆里背对背生闷气,她抱着手臂看向窗外,男生低头刷手机,暖色逆光",
        "who": "main",
        "big": "上头快,下头也快"
      }
    },
    {
      "id": "stomp",
      "label": "砸字",
      "use": "钩子、一句话定调、全片最狠的那句。字一个个砸下来。一条片最多用 2 次",
      "cues": "none",
      "fields": [
        {
          "key": "small",
          "label": "上面一行小字",
          "type": "text",
          "max": 12,
          "optional": true
        },
        {
          "key": "big",
          "label": "大字",
          "type": "text",
          "max": 12
        }
      ],
      "example": {
        "small": "别再拿星座合盘猜了",
        "big": "正缘写在你八字里"
      }
    },
    {
      "id": "ask",
      "label": "推进问句",
      "use": "抛问题、转折(\"那为什么…?\"\"问题是…\")。小字先出,大问句再落,镜头慢慢推近",
      "cues": "none",
      "fields": [
        {
          "key": "a",
          "label": "铺垫小字",
          "type": "text",
          "max": 14,
          "optional": true
        },
        {
          "key": "b",
          "label": "大问句",
          "type": "text",
          "max": 14
        }
      ],
      "example": {
        "a": "不是没遇到好的",
        "b": "是窗口还没开?"
      }
    },
    {
      "id": "lines",
      "label": "逐句落",
      "use": "口播里有 2-4 个并列短句/排比/递进时,念到哪句落哪句,最后一句高亮",
      "cues": "lines",
      "fields": [
        {
          "key": "kicker",
          "label": "顶部标签",
          "type": "text",
          "max": 10,
          "optional": true
        },
        {
          "key": "lines",
          "label": "短句",
          "type": "list",
          "min": 2,
          "max": 4,
          "itemMax": 10
        }
      ],
      "example": {
        "kicker": "偏缘的样子",
        "lines": [
          "上来特别上头",
          "聊啥都投机",
          "三个月就开始吵"
        ]
      }
    },
    {
      "id": "quote",
      "label": "金句",
      "use": "能单独截图传播的一句话、结尾落点。宋体大字逐字浮现,重点词描金",
      "cues": "none",
      "fields": [
        {
          "key": "text",
          "label": "金句",
          "type": "text",
          "max": 28
        },
        {
          "key": "em",
          "label": "重点词(必须是金句里的原文)",
          "type": "text",
          "max": 8,
          "optional": true
        },
        {
          "key": "by",
          "label": "出处",
          "type": "text",
          "max": 10,
          "optional": true
        }
      ],
      "example": {
        "text": "别在错的人身上,把正缘的运气给耗没了",
        "em": "正缘的运气"
      }
    },
    {
      "id": "glyph",
      "label": "大单字",
      "use": "一个字/一个术语就能讲完一件事(合、冲、官、杀、偏缘)。巨大的宋体字+术语标签+一句解释",
      "cues": "chips,note",
      "fields": [
        {
          "key": "glyph",
          "label": "大字(1-2 个字)",
          "type": "text",
          "max": 2
        },
        {
          "key": "label",
          "label": "字下面的名称",
          "type": "text",
          "max": 6,
          "optional": true
        },
        {
          "key": "chips",
          "label": "术语标签",
          "type": "list",
          "min": 0,
          "max": 3,
          "itemMax": 4,
          "optional": true
        },
        {
          "key": "note",
          "label": "一句解释",
          "type": "text",
          "max": 24,
          "optional": true
        },
        {
          "key": "tone",
          "label": "颜色",
          "type": "select",
          "options": [
            "main",
            "alt"
          ],
          "optional": true,
          "labels": {
            "main": "主色",
            "alt": "第二色(粉)"
          }
        }
      ],
      "example": {
        "glyph": "官",
        "label": "正 官 旺",
        "chips": [
          "靠谱",
          "稳重"
        ],
        "note": "对方大概率是踏实过日子的那种"
      }
    },
    {
      "id": "number",
      "label": "大数字",
      "use": "一个关键数字/年份/分数。数字滚出来。数字必须是台词或参考材料里真有的",
      "cues": "value",
      "fields": [
        {
          "key": "kicker",
          "label": "顶部标签",
          "type": "text",
          "max": 12,
          "optional": true
        },
        {
          "key": "value",
          "label": "数字",
          "type": "text",
          "max": 8
        },
        {
          "key": "unit",
          "label": "单位",
          "type": "text",
          "max": 3,
          "optional": true
        },
        {
          "key": "note",
          "label": "说明",
          "type": "text",
          "max": 20,
          "optional": true
        }
      ],
      "example": {
